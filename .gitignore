# Submission budget: at most 3.75 MiB under artifacts/ (2.5 MiB JSON,
# 1.25 MiB screenshots); all other submitted paths share the remaining
# 4.25 MiB of the assignment's 8 MiB total. Only these nine files are allowed.
!/artifacts/
/artifacts/*
!/artifacts/003-counts.json
!/artifacts/003-story-evidence.json
!/artifacts/003-interaction-results.json
!/artifacts/003-render-review.json
